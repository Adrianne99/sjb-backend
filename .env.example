# =============================================================================
# Backend environment variables — copy this file to `.env` and fill it in.
# Never commit `.env`. Every value here stays on the server only.
# =============================================================================

NODE_ENV=development
PORT=5000

# MySQL connection. XAMPP default: user "root" with an empty password.
#   mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/saint_john_bosco_sms"

# Secret used to hash session and password-reset tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Public URL of the React app (used in password-reset email links).
FRONTEND_URL=http://localhost:5173

# Cookie SameSite policy: lax (recommended — use the Vercel /api rewrite),
# or none (only if the frontend calls the backend on a different site).
COOKIE_SAME_SITE=lax

# Resend transactional email (optional in development — emails are printed
# to the console when the key is empty).
RESEND_API_KEY=
EMAIL_FROM="Saint John Bosco SMS <no-reply@example.com>"

# AI chatbot (OpenRouter — https://openrouter.ai/keys). Backend only, never in the frontend.
# Leave AI_API_KEY empty to use the keyword FAQ only. If the AI fails, the FAQ answers.
AI_API_KEY=
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_TIMEOUT_MS=20000

# Login protection: max FAILED logins per IP address per 15 minutes
LOGIN_RATE_LIMIT_MAX=20

# -----------------------------------------------------------------------------
# Development seed only (npm run db:seed). Never used in production.
# -----------------------------------------------------------------------------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@school.test
SEED_ADMIN_PASSWORD=
# Password for the demo staff account and the demo student who has already
# changed their temporary password.
SEED_DEMO_PASSWORD=
